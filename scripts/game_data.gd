class_name GameData
extends RefCounted

## All the tunable game data lives here: the books of brew recipes and the themed word lists.
##
## Names: what the player sees as a *book of brew recipes* is a "level" in the code (LEVELS),
## and the *levels* inside a book are its words.

## How many words (levels, to the player) a book has, unless it sets its own "words".
const WORDS_PER_LEVEL := 10

## One entry per book of brew recipes (index 0 = book 1), each harder than the last.
## words (optional): how many words are in the book; its best score is the same number
## min_len / max_len: length of the words picked for the level
## missing_min / missing_max: how many letters are taken out of the word
## decoys: how many wrong letters are mixed in on the table
## mixed (optional): true = every word comes from another random theme, so no theme is picked for the book
## gaps_visible: true = empty slots show where letters go, false = you must work it out
## The books climb like a staircase: one thing gets harder at a time. A new number of letters always
## starts with the gaps shown; only once that is familiar are they hidden (the smoke test checks this).
## The first books with 3 letters have one wrong letter fewer than the book before, to make that step easier.
const LEVELS: Array[Dictionary] = [
	# 1 letter: one book with the gaps shown, then two with the gaps hidden
	{"min_len": 3, "max_len": 4, "missing_min": 1, "missing_max": 1, "decoys": 2, "gaps_visible": true},
	{"min_len": 4, "max_len": 5, "missing_min": 1, "missing_max": 1, "decoys": 2, "gaps_visible": false},
	{"min_len": 4, "max_len": 6, "missing_min": 1, "missing_max": 1, "decoys": 3, "gaps_visible": false},
