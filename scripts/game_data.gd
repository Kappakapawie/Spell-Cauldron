## How far a word's length is outside a level's range (0 = it fits).
static func length_distance(length: int, settings: Dictionary) -> int:
	return maxi(0, maxi(int(settings.min_len) - length, length - int(settings.max_len)))


## How many words a book with these settings has.
static func words_in(settings: Dictionary) -> int:
	return int(settings.get("words", WORDS_PER_LEVEL))


## How many words book n has. Each is worth 1 point, so this is also its perfect score.
static func word_count(n: int) -> int:
	return words_in(book(n))


## The perfect score of all books together.
static func total_words() -> int:
	var total := 0
	for n in range(1, book_count() + 1):
		total += word_count(n)
	return total


## Page 2 of the shelves: the mystery books, numbers 30 and up in the code. Each plays like the normal book
## named here, but every word has its own random theme, and it is a secret. They climb the same staircase as
## the normal books, squeezed into 20: every number of missing letters starts with the gaps shown (twice from
## 2 letters on), then hidden; never easier than the book before (the smoke test checks this).
const MYSTERY_LIKE: Array[int] = [1, 2, 4, 5, 6, 7, 8, 9, 10, 12, 14, 15, 17, 18, 20, 22, 24, 25, 27, 29]


## All books: the normal ones, then the mystery ones.
static func book_count() -> int:
	return LEVELS.size() + MYSTERY_LIKE.size()


static func is_mystery(n: int) -> bool:
	return n > LEVELS.size()


## The settings of book n (1 = the first normal book; after the normal books come the mystery books).
## A mystery book is always mixed: a new secret theme for every word.
static func book(n: int) -> Dictionary:
	if not is_mystery(n):
		return LEVELS[n - 1]
	var settings: Dictionary = LEVELS[MYSTERY_LIKE[n - LEVELS.size() - 1] - 1].duplicate()
	settings["mixed"] = true
	settings["mystery"] = true
	return settings


## The number on the book's cover: mystery books count from 1 again.
static func book_number(n: int) -> int:
	return n - LEVELS.size() if is_mystery(n) else n


## "Brew recipes 3" or "Mystery recipes 5".
static func book_title(n: int) -> String:
	return ("Mystery recipes %d" if is_mystery(n) else "Brew recipes %d") % book_number(n)


## The fewest and most letters a book can really take out of its words.
static func missing_span(settings: Dictionary) -> Vector2i:
	return Vector2i(mini(settings.missing_min, most_missing(settings.min_len)),
		mini(settings.missing_max, most_missing(settings.max_len)))


## At most 60 % of a word is taken out, so short words in hard books stay readable.
static func most_missing(length: int) -> int:
	return maxi(1, floori(length * 0.6))


## The pictures of an entry, the most telling one first.
static func pictures(entry: Array) -> PackedStringArray:
	return String(entry[2]).split(" ", false) if entry.size() > 2 else PackedStringArray()


## Every [word, meaning, pictures] entry of every theme.
static func all_words() -> Array:
	var out: Array = []
	for theme in THEMES:
		out.append_array(THEMES[theme])
	return out
